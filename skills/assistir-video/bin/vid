#!/usr/bin/env bash
# vid - pipeline de percepcao de video para o Claude.
# O modelo nao le video. Le imagem e texto. Este script transforma um em outro.
set -euo pipefail

# App de desktop lancado pela GUI nao herda o PATH do perfil do shell: sem isto,
# ffmpeg e yt-dlp somem e o erro que aparece e "command not found".
# A ordem importa: o primeiro da lista tem que ficar na frente do PATH.
_prefixo=""
for _d in /opt/homebrew/bin "$HOME/.local/bin" /usr/local/bin /opt/local/bin \
          "$HOME/.cargo/bin" /home/linuxbrew/.linuxbrew/bin; do
  [ -d "$_d" ] && [[ ":$PATH:" != *":$_d:"* ]] && _prefixo="${_prefixo}${_d}:"
done
PATH="${_prefixo}${PATH}"
export PATH

# Ter python3 nao basta: precisa ser um que enxergue o Pillow. Numa maquina com
# varios pythons instalados, o primeiro do PATH costuma ser o errado.
PY=""
escolher_python() {
  [ -n "$PY" ] && return 0
  local cand
  for cand in python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 \
              /usr/bin/python3 python; do
    command -v "$cand" >/dev/null 2>&1 || continue
    if "$cand" -c "import PIL" 2>/dev/null; then PY="$cand"; return 0; fi
  done
  PY="$(command -v python3 2>/dev/null || echo python3)"
}

VIDEO_HOME="${VIDEO_HOME:-$HOME/.cache/assistir-video}"
FONT="${VID_FONT:-/System/Library/Fonts/Supplemental/Arial Bold.ttf}"
SHEET_COLS="${VID_SHEET_COLS:-3}"
SHEET_ROWS="${VID_SHEET_ROWS:-4}"
TILE_W="${VID_TILE_W:-520}"
MAX_SCAN="${VID_MAX_SCAN:-120}"

die() { echo "erro: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "falta o binario '$1'"; }

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//' | cut -c1-60
}

hhmmss() { # segundos -> 00h00m00s (nome de arquivo ordenavel)
  awk -v s="$1" 'BEGIN{printf "%02dh%02dm%02ds", s/3600, (s%3600)/60, s%60}'
}

label_ts() { # segundos -> 00:00:00 (rotulo humano)
  awk -v s="$1" 'BEGIN{printf "%02d:%02d:%02d", s/3600, (s%3600)/60, s%60}'
}

wd() { echo "$VIDEO_HOME/$1"; }

manifest_get() {
  jq -r --arg k "$2" '.[$k] // empty' "$(wd "$1")/manifest.json"
}

# ---------------------------------------------------------------- prep
cmd_prep() {
  need ffprobe; need jq
  local src="${1:?uso: vid prep <arquivo|url> [slug]}" slug="${2:-}"
  local dir file title

  if [[ "$src" =~ ^https?:// ]]; then
    need yt-dlp
    title="$(yt-dlp --print "%(title)s" --no-warnings "$src" 2>/dev/null | head -1)"
    [ -z "$title" ] && title="video-remoto"
    slug="${slug:-$(slugify "$title")}"
    dir="$(wd "$slug")"; mkdir -p "$dir/source"
    if ! ls "$dir/source"/video.* >/dev/null 2>&1; then
      echo "baixando: $title" >&2
      yt-dlp -f "bv*[height<=720]+ba/b[height<=720]/b" --merge-output-format mp4 \
        -o "$dir/source/video.%(ext)s" "$src" >&2
    fi
    file="$(ls "$dir/source"/video.* | head -1)"
  else
    [ -f "$src" ] || die "arquivo nao existe: $src"
    title="$(basename "$src")"
    slug="${slug:-$(slugify "${title%.*}")}"
    dir="$(wd "$slug")"; mkdir -p "$dir/source"
    file="$dir/source/video.${src##*.}"
    [ -e "$file" ] || ln -s "$(cd "$(dirname "$src")" && pwd)/$(basename "$src")" "$file"
  fi

  mkdir -p "$dir"/{audio,transcript,frames/scan,frames/zoom,sheets,clips}
  local probe dur w h fps has_audio
  probe="$(ffprobe -v quiet -print_format json -show_format -show_streams "$file")"
  dur="$(echo "$probe"  | jq -r '.format.duration // "0"' | cut -d. -f1)"
  w="$(echo "$probe"    | jq -r '[.streams[]|select(.codec_type=="video")][0].width  // 0')"
  h="$(echo "$probe"    | jq -r '[.streams[]|select(.codec_type=="video")][0].height // 0')"
  fps="$(echo "$probe"  | jq -r '[.streams[]|select(.codec_type=="video")][0].r_frame_rate // "0/1"')"
  has_audio="$(echo "$probe" | jq -r '[.streams[]|select(.codec_type=="audio")]|length>0')"

  jq -n --arg slug "$slug" --arg title "$title" --arg src "$src" --arg file "$file" \
        --argjson dur "${dur:-0}" --argjson w "$w" --argjson h "$h" \
        --arg fps "$fps" --argjson audio "$has_audio" \
    '{slug:$slug,title:$title,source:$src,file:$file,duracao_s:$dur,
      largura:$w,altura:$h,fps:$fps,tem_audio:$audio}' > "$dir/manifest.json"

  echo "slug:     $slug"
  echo "titulo:   $title"
  echo "duracao:  $(label_ts "$dur")  ($dur s)"
  echo "video:    ${w}x${h} @ $fps"
  echo "audio:    $has_audio"
  echo "workdir:  $dir"
  plano "$dur"
}

plano() { # sugere intervalo de amostragem pela duracao
  local dur="$1" cada
  if   [ "$dur" -le 300 ];  then cada=10
  elif [ "$dur" -le 1200 ]; then cada=20
  elif [ "$dur" -le 3600 ]; then cada=45
  else                           cada=90
  fi
  local n=$(( dur / cada + 1 ))
  [ "$n" -gt "$MAX_SCAN" ] && { cada=$(( dur / MAX_SCAN + 1 )); n=$MAX_SCAN; }
  echo "plano:    --cada ${cada}s  ~${n} frames  ~$(( (n + SHEET_COLS*SHEET_ROWS - 1) / (SHEET_COLS*SHEET_ROWS) )) folhas"
}

# ---------------------------------------------------------------- ouvir
cmd_ouvir() {
  need ffmpeg
  local slug="${1:?uso: vid ouvir <slug> [--modelo small]}"; shift || true
  local modelo="small" dir; dir="$(wd "$slug")"
  while [ $# -gt 0 ]; do case "$1" in --modelo) modelo="$2"; shift 2;; *) shift;; esac; done

  local file; file="$(manifest_get "$slug" file)"
  [ -f "$dir/transcript/transcript.md" ] && { echo "ja existe: $dir/transcript/transcript.md"; return 0; }
  [ "$(manifest_get "$slug" tem_audio)" = "true" ] || { echo "video sem faixa de audio"; return 0; }

  local wav="$dir/audio/audio.wav"
  [ -f "$wav" ] || ffmpeg -nostdin -v error -y -i "$file" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$wav"

  need whisper
  echo "transcrevendo com whisper ($modelo). audio longo demora." >&2
  whisper "$wav" --model "$modelo" --output_dir "$dir/transcript" \
    --output_format json --verbose False >&2
  python3 "$(dirname "${BASH_SOURCE[0]}")/whisper_to_md.py" \
    "$dir/transcript/audio.json" "$(manifest_get "$slug" title)" > "$dir/transcript/transcript.md"
  echo "$dir/transcript/transcript.md"
}

# ---------------------------------------------------------------- frames
cmd_frames() {
  need ffmpeg
  local slug="${1:?uso: vid frames <slug> [--cada S | --cortes]}"; shift || true
  local dir file dur cada="" cortes=0
  dir="$(wd "$slug")"; file="$(manifest_get "$slug" file)"; dur="$(manifest_get "$slug" duracao_s)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --cada)   cada="$2"; shift 2;;
      --cortes) cortes=1; shift;;
      *) shift;;
    esac
  done

  local -a times=()
  if [ "$cortes" = 1 ]; then
    echo "detectando cortes de cena..." >&2
    while read -r t; do times+=("${t%.*}"); done < <(
      ffmpeg -nostdin -v info -i "$file" -filter:v "select='gt(scene,0.25)',showinfo" \
        -f null - 2>&1 | sed -n 's/.*pts_time:\([0-9.]*\).*/\1/p' | head -"$MAX_SCAN"
    )
    times=(0 "${times[@]:-}")
  else
    if [ -z "$cada" ]; then
      if   [ "$dur" -le 300 ];  then cada=10
      elif [ "$dur" -le 1200 ]; then cada=20
      elif [ "$dur" -le 3600 ]; then cada=45
      else                           cada=90; fi
      [ $(( dur / cada )) -gt "$MAX_SCAN" ] && cada=$(( dur / MAX_SCAN + 1 ))
    fi
    local t=0
    while [ "$t" -lt "$dur" ]; do times+=("$t"); t=$(( t + cada )); done
  fi

  rm -f "$dir"/frames/scan/*.jpg 2>/dev/null || true
  local i=0
  for t in "${times[@]}"; do
    [ -z "$t" ] && continue
    ffmpeg -nostdin -v error -ss "$t" -i "$file" -frames:v 1 \
      -vf "scale=${TILE_W}:-2" \
      -q:v 3 -y "$dir/frames/scan/$(printf '%03d' "$i")_$(hhmmss "$t").jpg" 2>/dev/null || true
    i=$(( i + 1 ))
  done
  # a hora vai gravada na imagem por PIL: este ffmpeg nao tem drawtext
  escolher_python
  "$PY" "$(dirname "${BASH_SOURCE[0]}")/frames_tool.py" rotular "$dir/frames/scan"
  echo "$(ls "$dir"/frames/scan/*.jpg 2>/dev/null | wc -l | tr -d ' ') frames em $dir/frames/scan"
}

# ---------------------------------------------------------------- folhas
cmd_folhas() {
  local slug="${1:?uso: vid folhas <slug>}"; local dir; dir="$(wd "$slug")"
  ls "$dir"/frames/scan/*.jpg >/dev/null 2>&1 || die "rode 'vid frames $slug' antes"
  escolher_python
  "$PY" "$(dirname "${BASH_SOURCE[0]}")/frames_tool.py" folhas \
    "$dir/frames/scan" "$dir/sheets" "$SHEET_COLS" "$SHEET_ROWS"
}

# ---------------------------------------------------------------- zoom
cmd_zoom() {
  need ffmpeg
  local slug="${1:?uso: vid zoom <slug> <mm:ss|segundos> [...]}"; shift
  local dir file; dir="$(wd "$slug")"; file="$(manifest_get "$slug" file)"
  for raw in "$@"; do
    local t
    if [[ "$raw" == *:* ]]; then
      t="$(awk -F: '{n=NF; s=0; for(i=1;i<=n;i++) s=s*60+$i; print s}' <<<"$raw")"
    else t="$raw"; fi
    local out="$dir/frames/zoom/$(hhmmss "$t").png"
    ffmpeg -nostdin -v error -ss "$t" -i "$file" -frames:v 1 \
      -vf "scale='min(1568,iw)':-2" -y "$out" 2>/dev/null || true
    echo "$out"
  done
  cmd_custo "$dir"/frames/zoom/*.png
}

# ---------------------------------------------------------------- clipe
cmd_clipe() {
  need ffmpeg
  local slug="${1:?uso: vid clipe <slug> <inicio> <fim>}" ini="${2:?}" fim="${3:?}"
  local dir file; dir="$(wd "$slug")"; file="$(manifest_get "$slug" file)"
  local out="$dir/clips/$(echo "$ini-$fim" | tr ':' '.').mp4"
  ffmpeg -nostdin -v error -ss "$ini" -to "$fim" -i "$file" -c copy -y "$out"
  echo "$out"
}

# ---------------------------------------------------------------- custo
cmd_custo() {
  need ffprobe
  local total=0
  for f in "$@"; do
    [ -f "$f" ] || continue
    local wh w h tk
    wh="$(ffprobe -v quiet -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$f")"
    w="${wh%x*}"; h="${wh#*x}"
    # a API reduz o lado maior para 1568px antes de contar
    tk=$(awk -v w="$w" -v h="$h" 'BEGIN{m=(w>h?w:h); if(m>1568){s=1568/m; w*=s; h*=s} print int(w*h/750)}')
    total=$(( total + tk ))
  done
  echo "custo estimado: ~${total} tokens de visao em $# imagem(ns)"
}

# ---------------------------------------------------------------- varrer
cmd_varrer() {
  need yt-dlp
  local url="${1:?uso: vid varrer <url-canal-ou-playlist> [pasta-saida]}"
  local out="${2:-./transcricoes}"
  local script_dir; script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  mkdir -p "$out/.subs"
  local lista="$out/.subs/lista.txt"
  yt-dlp --flat-playlist --print "%(id)s|%(duration)s|%(title)s" "$url" > "$lista"
  echo "$(wc -l < "$lista" | tr -d ' ') itens" >&2

  while IFS='|' read -r id dur title; do
    [ -z "${id:-}" ] && continue
    [ -s "$out/${id}.md" ] && { echo "SKIP $id"; continue; }
    local j="$out/.subs/${id}.pt-orig.json3"
    [ -s "$j" ] || yt-dlp --write-auto-sub --sub-lang "pt-orig" --sub-format json3 \
        --skip-download --retries 5 --sleep-requests 1 \
        -o "$out/.subs/%(id)s.%(ext)s" "https://www.youtube.com/watch?v=${id}" >/dev/null 2>&1 || true
    if [ ! -s "$j" ]; then
      for alt in "$out/.subs/${id}.pt".*.json3 "$out/.subs/${id}.pt.json3"; do
        [ -s "$alt" ] && { j="$alt"; break; }
      done
    fi
    [ -s "$j" ] || { echo "FALHA $id  $title"; continue; }
    python3 "$script_dir/json3_to_md.py" "$j" "$title" "$id" > "$out/${id}.md"
    echo "OK   $id  $(wc -w < "$out/${id}.md" | tr -d ' ')w  $title"
  done < "$lista"
}

# ---------------------------------------------------------------- doctor
cmd_doctor() {
  local falhou=0
  echo "PATH efetivo: $PATH"
  echo
  printf "%-12s %-8s %s\n" "FERRAMENTA" "ESTADO" "CAMINHO / OBSERVACAO"
  local -a obrig=(ffmpeg ffprobe jq python3)
  local -a extra=(yt-dlp uv gallery-dl whisper)
  for b in "${obrig[@]}"; do
    if command -v "$b" >/dev/null 2>&1; then
      printf "%-12s %-8s %s\n" "$b" "ok" "$(command -v "$b")"
    else
      printf "%-12s %-8s %s\n" "$b" "FALTA" "obrigatorio"; falhou=1
    fi
  done
  for b in "${extra[@]}"; do
    if command -v "$b" >/dev/null 2>&1; then
      printf "%-12s %-8s %s\n" "$b" "ok" "$(command -v "$b")"
    else
      case "$b" in
        yt-dlp)     printf "%-12s %-8s %s\n" "$b" "FALTA" "sem YouTube"; falhou=1;;
        uv)         printf "%-12s %-8s %s\n" "$b" "FALTA" "sem 'pb pdf'";;
        gallery-dl) printf "%-12s %-8s %s\n" "$b" "FALTA" "sem Instagram";;
        whisper)    printf "%-12s %-8s %s\n" "$b" "-" "opcional: video sem legenda";;
      esac
    fi
  done

  escolher_python
  if "$PY" -c "import PIL" 2>/dev/null; then
    printf "%-12s %-8s %s\n" "Pillow" "ok" "via $PY"
  else
    printf "%-12s %-8s %s\n" "Pillow" "FALTA" "nenhum python com PIL"; falhou=1
  fi

  if ffmpeg -hide_banner -filters 2>/dev/null | grep -q drawtext; then
    printf "%-12s %-8s %s\n" "drawtext" "ok" "(nao usado: o kit rotula com Pillow)"
  else
    printf "%-12s %-8s %s\n" "drawtext" "-" "ffmpeg sem libfreetype; Pillow cobre"
  fi

  local chrome=""
  for c in "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
           "/Applications/Chromium.app/Contents/MacOS/Chromium"; do
    [ -x "$c" ] && chrome="$c" && break
  done
  [ -z "$chrome" ] && chrome="$(command -v google-chrome || command -v chromium || true)"
  if [ -n "$chrome" ]; then
    printf "%-12s %-8s %s\n" "chrome" "ok" "$chrome"
  else
    printf "%-12s %-8s %s\n" "chrome" "-" "sem 'pb pdf'"
  fi

  echo
  if [ "$falhou" = 1 ]; then
    echo "Algo obrigatorio falta. Rode o install.sh do kit."
    return 1
  fi
  echo "Ambiente ok."
}

# ---------------------------------------------------------------- status
cmd_status() {
  local slug="${1:?uso: vid status <slug>}" dir; dir="$(wd "$slug")"
  [ -d "$dir" ] || die "sem workdir para '$slug'"
  jq . "$dir/manifest.json"
  echo "transcricao: $([ -f "$dir/transcript/transcript.md" ] && echo sim || echo nao)"
  echo "frames scan: $(ls "$dir"/frames/scan/*.jpg 2>/dev/null | wc -l | tr -d ' ')"
  echo "folhas:      $(ls "$dir"/sheets/*.jpg 2>/dev/null | wc -l | tr -d ' ')"
  echo "zoom:        $(ls "$dir"/frames/zoom/*.png 2>/dev/null | wc -l | tr -d ' ')"
}

case "${1:-}" in
  prep)   shift; cmd_prep   "$@";;
  ouvir)  shift; cmd_ouvir  "$@";;
  frames) shift; cmd_frames "$@";;
  folhas) shift; cmd_folhas "$@";;
  zoom)   shift; cmd_zoom   "$@";;
  clipe)  shift; cmd_clipe  "$@";;
  custo)  shift; cmd_custo  "$@";;
  varrer) shift; cmd_varrer "$@";;
  status) shift; cmd_status "$@";;
  doctor) shift; cmd_doctor "$@";;
  ls)     ls -1 "$VIDEO_HOME" 2>/dev/null;;
  *) cat >&2 <<'USO'
vid - pipeline de percepcao de video

  vid prep   <arquivo|url> [slug]   ingere, sonda, sugere plano de amostragem
  vid ouvir  <slug> [--modelo m]    audio -> transcript.md com timestamps
  vid frames <slug> [--cada S|--cortes]  frames com hora gravada na imagem
  vid folhas <slug>                 monta folhas de contato (o que o Claude le)
  vid zoom   <slug> <mm:ss ...>     frame em resolucao cheia para ler detalhe
  vid clipe  <slug> <ini> <fim>     recorta trecho como evidencia
  vid custo  <imagens...>           estima tokens de visao antes de ler
  vid varrer <url-canal> [pasta]    colhe transcricoes de um canal inteiro
  vid status <slug> | vid ls
  vid doctor                        diagnostica o ambiente (rode isto primeiro)
USO
    exit 1;;
esac
